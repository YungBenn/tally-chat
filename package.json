{
  "name": "tally-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "convex dev --start 'next dev'",
    "predev": "convex init && node setup.mjs --once",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\" --ignore-pattern \"docs/**\" --ignore-pattern \"prototypes/**\"",
    "test": "vitest run",
    "sync-prices": "node scripts/sync-prices.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.82",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/persistent-text-streaming": "0.3.5",
    "@tabler/icons-react": "^3.50.0",
    "ai": "7.0.159",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.66",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
